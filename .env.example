# Variables de entorno para Hostal Rivera
# Copiar a .env y ajustar valores reales
#
# Para Docker local: usar con docker-compose.local.yml
# Para Dokploy: configurar en el panel de Dokploy (no usar .env)

SECRET_KEY=cambia-esta-clave-por-una-aleatoria-de-50-caracteres
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
ADMIN_PATH=admin/

# Base de datos (PostgreSQL en Docker)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=hotel_db
DB_USER=hotel_user
DB_PASSWORD=cambia-esta-contrasena
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECKS=True

# Proxy y seguridad (local: False, Dokploy: True para BEHIND_PROXY)
BEHIND_PROXY=False
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
CSRF_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
